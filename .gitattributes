# Scripts shell SEMPRE com LF, mesmo que o repo seja editado no Windows.
# Sem isso o bash da VPS falha com "$'\r': command not found".
*.sh   text eol=lf
*.conf text eol=lf
*.py   text eol=lf
*.service text eol=lf
Dockerfile text eol=lf
*.yml  text eol=lf

# Arquivos .reg são UTF-16LE (formato exigido pelo regedit): não converter.
*.reg binary
